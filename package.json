{
  "name": "ball-drop-endless-live",
  "version": "1.0.0",
  "private": true,
  "description": "Zero-cost local endless vertical ball-drop livestream for Apple Silicon Macs",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts --preview",
    "test:local": "TEST_MODE=true tsx src/index.ts --test",
    "diagnostics": "tsx src/index.ts --diagnostics",
    "preview:layout": "tsx src/index.ts --preview-layout",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:production": "NODE_ENV=production TEST_MODE=false node dist/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.7",
    "matter-js": "^0.20.0",
    "playwright": "^1.49.1",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/matter-js": "^0.19.8",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
